{
  "name": "youtube-shorts-generator-backend",
  "version": "1.0.0",
  "description": "Express.js API backend for AI-powered YouTube Shorts generator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:init": "node scripts/initDb.js",
    "db:migrate": "node scripts/migrate.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "youtube",
    "shorts",
    "ai",
    "video",
    "generation",
    "express"
  ],
  "author": "AI Shorts Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "nodemon": "^2.0.22",
    "eslint": "^8.43.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
